# XIIO — copy to .env.local (do not commit secrets)

# Firebase client
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore DB id — Console 상단 드롭다운 이름 (예: xiio). 비우면 (default)
# 로컬·Vercel·Admin SDK(FIREBASE_FIRESTORE_DATABASE_ID) 모두 동일한 DB를 가리켜야 합니다.
# NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=xiio

# Admin — UIDs (optional), emails, super admin email
# ADMIN_UIDS=
# ADMIN_EMAILS=
# ADMIN_SUPER_EMAIL=

# Firebase Admin SDK (server) — service account JSON as one line, or ADC locally
# FIREBASE_SERVICE_ACCOUNT_JSON=
#
# GitHub Actions (firebase-deploy workflow) — same values as secrets:
# FIREBASE_PROJECT_ID → secret FIREBASE_PROJECT_ID
# FIREBASE_SERVICE_ACCOUNT_JSON → secret FIREBASE_SERVICE_ACCOUNT_JSON
# See docs/firebase-deploy.md

# Uploader deposit (Stripe MVP — one provider)
# UPLOADER_DEPOSIT_ENABLED=true  # config.ts UPLOADER_DEPOSIT_FORCE_DISABLED=false 일 때만 적용
# PAYMENT_PROVIDERS_ENABLED=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# UPLOADER_DEPOSIT_AMOUNT_CENTS=100
# UPLOADER_DEPOSIT_CURRENCY=usd

# Cloudflare Stream
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# Optional separate read-only token for Stream GraphQL analytics.
# Requires Account Analytics: Read. Falls back to CLOUDFLARE_STREAM_API_TOKEN.
# CLOUDFLARE_ANALYTICS_API_TOKEN=
# Stream webhook — register: ./scripts/register-stream-webhook.sh (API 응답의 secret)
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# 로컬 테스트 URL: STREAM_WEBHOOK_URL=https://xxxx.ngrok-free.app/api/webhooks/cloudflare-stream
# Optional: customer subdomain for playback URLs (e.g. customer-xxxxx.cloudflarestream.com)
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# Admin operations dashboard cost controls (optional)
# Firebase/source storage rate used for estimates, in USD per GB-month.
# XIIO_SOURCE_STORAGE_COST_PER_GB_MONTH=
# Budget threshold shown in the dashboard.
# XIIO_MONTHLY_VIDEO_BUDGET_USD=

# Professional network & portfolio — see docs/product-network.md

# Collaborator email invites (Resend) — required to email credits to users not yet on XIIO
# https://resend.com → API Keys + Domains (verify SPF/DKIM for your sending domain)
# RESEND_API_KEY=re_xxxxxxxx
# Must use an address on a verified domain (NOT onboarding@resend.dev — that only delivers to your Resend account email)
# RESEND_FROM_EMAIL=XIIO <noreply@your-verified-domain.com>
# School email OTP: random secret, at least 32 characters. Server-only; never NEXT_PUBLIC.
# SCHOOL_VERIFICATION_SECRET=
# Also configure reviewed exact emailDomains on each active schools/{schoolId} document.
# Invite email links use NEXT_PUBLIC_APP_URL (see Social login section below)

# AI content moderation — see docs/content-moderation.md
# CONTENT_MODERATION_ENABLED=true
# launch (cost): google | value: hive | premium: sightengine
# CONTENT_MODERATION_VIDEO_PROVIDER=google
# GEMINI_API_KEY=
# Uses FIREBASE_SERVICE_ACCOUNT_JSON or ADC for Google Video Intelligence
# HIVE_API_KEY=
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=

# Optional region default for checkout
# DEFAULT_PROVIDER_BY_REGION={"KR":"toss","INTL":"stripe"}

# Social login — see docs/social-auth-setup.md

# Kakao Login (developers.kakao.com → 앱 → 앱 키)
# Web platform site domains: http://localhost:3000, https://your-production-domain.com
# NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# KAKAO_REST_API_KEY=

# Naver Login (developers.naver.com → 애플리케이션 → Client ID / Secret)
# Callback URL in console: https://<host>/api/auth/naver/callback (HTTPS only; local → ngrok)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# Same host as Naver "서비스 URL" (no trailing slash)
# NEXT_PUBLIC_APP_URL=https://xiio.vercel.app
