# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app.

# Backend: the deployed website whose /api routes the app calls.
EXPO_PUBLIC_API_BASE_URL=https://xiio.vercel.app

# Firebase web config: same values as the website's NEXT_PUBLIC_FIREBASE_*.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Named Firestore database (website: NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID). Empty = (default).
EXPO_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=

# Google Sign-In (Firebase console > Authentication > Google > Web client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS: REVERSED_CLIENT_ID from GoogleService-Info.plist (com.googleusercontent.apps....).
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# iOS: CLIENT_ID from GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
